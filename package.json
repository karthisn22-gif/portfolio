{
  "name": "portfolio-mern",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "server": "node --watch server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "build": "npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}